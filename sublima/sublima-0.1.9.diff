+    return;
+  unsigned long got = 0;
+  const unsigned char *buf = input->read(maxLen < 112 ? maxLen : 112, got);
+  if (!buf || got < 64)
+    return;
+  std::vector<unsigned char> b(buf, buf + got);
+  input->seek(start, librevenge::RVNG_SEEK_SET);
+  auto u32 = [&](size_t o) -> unsigned { return o + 4 <= b.size() ? (unsigned)(b[o] | (b[o+1] << 8) | (b[o+2] << 16) | ((unsigned)b[o+3] << 24)) : 0u; };
+  librevenge::RVNGPropertyList props;
+  props.insert("sublima:shadow-dx-in", (double)(int)u32(8) / 254000.0, librevenge::RVNG_GENERIC);
+  props.insert("sublima:shadow-dy-in", (double)(int)u32(12) / 254000.0, librevenge::RVNG_GENERIC);
+  props.insert("sublima:shadow-opacity", (double)u32(16) / 255.0, librevenge::RVNG_GENERIC);
+  unsigned c = u32(65);
+  librevenge::RVNGString color;
+  color.sprintf("#%.2x%.2x%.2x", (c >> 16) & 0xff, (c >> 8) & 0xff, c & 0xff);
+  props.insert("sublima:shadow-color", color);
+  librevenge::RVNGString raw;
+  for (size_t i = 0; i < b.size(); ++i)
+  {
+    librevenge::RVNGString h;
+    h.sprintf("%.2x", b[i]);
+    raw.append(h);
+  }
+  props.insert("sublima:shadow-raw", raw);
+  m_collector->collectDropShadow(props);
+}
