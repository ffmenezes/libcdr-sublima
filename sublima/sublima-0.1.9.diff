+  if (n > 10000 || total > getRemainingLength(input) + 8)
+    return;
+  readU32(input); // tamanho do cabecalho
+  std::vector<unsigned> offs;
+  for (unsigned i = 0; i < n; ++i)
+    offs.push_back(readU32(input));
+  for (unsigned o : offs)
