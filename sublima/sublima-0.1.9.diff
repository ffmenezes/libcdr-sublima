+// Sublima: transparencia de objeto (X6+). Argumento 0x1f40 = cabecalho binario + JSON de estilo do objeto.
+//   u32 @37 = transparencia ligada; i32 @41 = tipo; double @69 = transparencia (%)
+//   JSON "transparency": { "mode", "fill": {"type", "fillName", "vectorBoundingBox", ...}, "startTransparency", ... }
+void libcdr::CDRParser::readTransparencyX6(librevenge::RVNGInputStream *input, unsigned long maxLen)
+{
+  const long start = input->tell();
+  if (maxLen > getRemainingLength(input))
+    maxLen = getRemainingLength(input);
+  if (maxLen < 90)
+    return;
+  unsigned long got = 0;
+  const unsigned char *buf = input->read(maxLen, got);
+  if (!buf || got < 90)
+    return;
+  std::vector<unsigned char> b(buf, buf + got);
+  input->seek(start, librevenge::RVNG_SEEK_SET);
+  auto u32 = [&](size_t o) -> unsigned { return o + 4 <= b.size() ? (unsigned)(b[o] | (b[o+1] << 8) | (b[o+2] << 16) | ((unsigned)b[o+3] << 24)) : 0u; };
+  auto dbl = [&](size_t o) -> double { double d = 0.0; if (o + 8 <= b.size()) memcpy(&d, &b[o], 8); return d; };
+  librevenge::RVNGPropertyList props;
+  unsigned enabled = u32(37);
+  int ttype = (int)u32(41);
+  double amount = dbl(69);
+  props.insert("sublima:transp-enabled", (int)enabled);
+  props.insert("sublima:transp-type", ttype);
+  if (std::isfinite(amount))
+    props.insert("sublima:transp-amount", amount, librevenge::RVNG_GENERIC);
+  // localizar o JSON: u32 tamanho seguido de '{'
+  for (size_t p = 4; p + 2 < b.size(); ++p)
+  {
+    if (b[p] != '{')
+      continue;
+    bool utf16 = b[p + 1] == 0;
+    const size_t step = utf16 ? 2 : 1;
+    // fim do JSON por contagem de chaves (o campo de tamanho varia entre versoes)
+    size_t bytes = 0;
+    {
+      int depth = 0;
+      bool inStr = false, esc = false;
+      for (size_t q = p; q + step - 1 < b.size(); q += step)
+      {
+        unsigned char ch = b[q];
+        if (utf16 && b[q + 1] != 0) { esc = false; continue; }
+        if (inStr)
+        {
+          if (esc) esc = false;
+          else if (ch == '\\') esc = true;
+          else if (ch == '"') inStr = false;
+          continue;
+        }
+        if (ch == '"') inStr = true;
+        else if (ch == '{') ++depth;
+        else if (ch == '}' && --depth == 0) { bytes = q + step - p; break; }
+      }
+    }
+    if (!bytes)
+      continue;
+    std::string json;
+    if (utf16)
+    {
+      for (size_t q = p; q + 1 < p + bytes; q += 2)
+      {
+        unsigned c = b[q] | (b[q+1] << 8);
+        if (c < 0x80) json += (char)c;
+        else if (c < 0x800) { json += (char)(0xc0 | (c >> 6)); json += (char)(0x80 | (c & 0x3f)); }
+        else { json += (char)(0xe0 | (c >> 12)); json += (char)(0x80 | ((c >> 6) & 0x3f)); json += (char)(0x80 | (c & 0x3f)); }
+      }
+    }
+    else
+      json.assign((const char *)&b[p], bytes);
+    try
+    {
+      boost::property_tree::ptree pt;
+      std::stringstream ss(json);
+      boost::property_tree::read_json(ss, pt);
+      boost::optional<boost::property_tree::ptree &> tr = pt.get_child_optional("transparency");
+      if (tr)
+      {
+        std::stringstream out;
+        boost::property_tree::write_json(out, tr.get(), false);
+        props.insert("sublima:transp-json", out.str().c_str());
+      }
+    }
+    catch (...)
+    {
+    }
+    break;
+  }
+  m_collector->collectTransparency(props);
+}
